{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Tracing": {
    "OtlpEndpoint": "http://otel-collector:4317"
  },
  "OpenTelemetry": {
    "EnableMetrics": true,
    "EnableTracing": true
  },
  "HealthChecks": {
    "Enabled": true
  }
}

