---
import { ClientRouter } from "astro:transitions";

import BackToTop from "../components/BackToTop.astro";
import Footer from "../components/Footer.astro";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import { MENU } from "../site";
import "../styles/base.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex } = Astro.props;
---

<!doctype html>
<html lang="en">
  <Head {title} {description} {image} {noindex}>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />
  </Head>

  <body>
    <a href="#content" class="btn primary sm sr-only skip-link"
      >Skip to main content</a
    >
    <Header>
      {
        MENU.map(({ label, href }) => (
          <li>
            <a href={href}>{label}</a>
          </li>
        ))
      }
    </Header>
    <main id="content">
      <slot />
    </main>
    <Footer backToTop={false}>
      <div>
        <h3>Pages</h3>
        <nav aria-label="Pages">
          <ul>
            {
              MENU.map(({ label, href }) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </Footer>
    <BackToTop />
  </body>
</html>
