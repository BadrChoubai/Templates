---
import { SITE } from "../site";

interface Props {
  /** Show the "back to top" link; turn off on sites that use BackToTop */
  backToTop?: boolean;
}

const { backToTop = true } = Astro.props;
---

<footer class="site-footer" id="footer">
  <div class="container">
    <!--
      Each child the site passes in is a column: a heading and a nav of
      links, or anything else, like a newsletter signup
    -->
    <div class="site-footer__inner">
      <slot />
    </div>

    <div class="site-footer__bottom">
      <small>&copy; {new Date().getFullYear()} {SITE.author}</small>
      {backToTop && <a href="#top">back to top</a>}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: var(--app-rule-width) solid var(--app-rule-color);
  }

  /*
   * The columns are the site's markup, rendered outside this component's
   * scope, so the rules that reach into them use :global()
   */
  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--app-spacing);
    padding-block: 2rem 1rem;
  }

  /* Four or more columns share the row evenly */
  .site-footer__inner:has(> :nth-child(4)) {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
  }

  .site-footer__inner :global(h3) {
    font-size: 0.875rem;
    color: var(--app-muted-color);
  }

  .site-footer__inner :global(ul) {
    flex-direction: column;
    gap: 0.375rem;
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 1rem;
    color: var(--app-muted-color);
  }

  @media screen and (max-width: 749px) {
    .site-footer__inner,
    .site-footer__inner:has(> :nth-child(4)) {
      grid-template-columns: 1fr;
      grid-auto-flow: row;
    }
  }
</style>
