---
import Section from "../components/Section.astro";
import { SITE } from "../site";
---

<Section class="section" id="hero">
  <h1>{SITE.title}</h1>
  <p class="hero__desc">{SITE.description}</p>

  <div class="hero__ctas">
    <a class="btn primary" href="#items">See the items</a>
    <a
      class="btn ghost"
      target="_blank"
      rel="noopener noreferrer"
      href="https://docs.astro.build/">Astro docs</a
    >
  </div>
</Section>

<style>
  .hero__desc {
    max-width: 40rem;
    color: var(--app-muted-color);
    font-size: 1.125rem;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
</style>
