---
import { getCollection } from "astro:content";
import Section from "../components/Section.astro";

const items = (await getCollection("items")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section class="section" id="items">
  <h2>Items</h2>

  <ul class="items" role="list">
    {
      items.map(({ data }) => (
        <li class="item">
          <h3 class="item__title">{data.title}</h3>
          <p class="item__desc">{data.description}</p>
          {data.tags.length > 0 && (
            <ul class="item__tags" aria-label="Tags">
              {data.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
          )}
          {data.link && (
            <div class="item__links">
              <a
                target="_blank"
                rel="noopener noreferrer"
                href={data.link}
                aria-label={`Learn more about ${data.title}`}
              >
                learn more
              </a>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--app-spacing);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: var(--app-border-width) solid var(--app-border-color);
    border-radius: var(--app-border-radius);
    transition: border-color var(--app-transition);
  }

  .item:hover,
  .item:focus-within {
    border-color: var(--app-accent-color);
  }

  .item__title {
    margin: 0;
  }

  .item__desc {
    flex-grow: 1;
    margin: 0;
    color: var(--app-muted-color);
  }

  .item__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;

    li {
      padding: 0.125rem 0.5rem;
      border-radius: var(--app-border-radius);
      background-color: var(--app-surface-color);
      font-size: 0.75rem;
    }
  }

  .item__links {
    font-size: 0.875rem;
  }
</style>
