{
  "name": "api",
  "version": "1.0.0",
  "description": "TypeScript API starter",
  "author": "Badr Choubai",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "serve": "node dist/index.js",
    "database:seed": "node dist/database/seedDb.js",
    "dev": "npm run develop",
    "develop": "concurrently \"npm run develop:watch\" \"npm run develop:serve\"",
    "develop:watch": "tsc --watch --preserveWatchOutput",
    "develop:serve": "nodemon --watch dist dist/index.js",
    "docker:build": "docker build -t api .",
    "docker:run": "docker run --rm -p 8082:8082 api",
    "docker:dev": "docker compose up --build",
    "docker:stop": "docker compose down",
    "lint": "eslint --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
